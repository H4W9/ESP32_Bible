# Claude Code
.claude/

# Arduino IDE local build output
build/
dist/
*.elf
*.bin
*.map
*.hex

# Arduino IDE temp files
/tmp/
*.orig

# OS
.DS_Store
Thumbs.db
*.pyc

# sd_prep generated SD output — regenerable from the Excel/TTF/JSONL sources,
# large, and not wanted in the repo. The scripts stay tracked.
sd_prep/__pycache__/
sd_prep/songs/
sd_prep/songs_fraktur/
sd_prep/dictionary/
sd_prep/bible_fraktur_out/

# Source Bible translations (OSIS XML) fed to generate_fraktur_bible.py, and any
# loose Bible XML — kept local, out of the repo (like the source spreadsheets).
sd_prep/bible/
sd_prep/*.xml

# Source spreadsheets (song/dictionary data) — kept local, out of the repo.
*.xlsx
